  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "FormFeedback": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "low_confidence",
              "incomplete_range",
              "body_alignment"
            ],
            "title": "Code",
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning"
            ],
            "title": "Severity",
            "type": "string"
          },
          "message": {
            "maxLength": 250,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "title": "FormFeedback",
        "type": "object"
      },
      "ExerciseType": {
        "enum": [
          "squat",
          "push_up"
        ],
        "title": "ExerciseType",
        "type": "string"
      },
      "WorkoutSession": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "exercise": {
            "$ref": "#/components/schemas/ExerciseType"
          },
          "challenge_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Challenge Id"
          },
          "status": {
            "enum": [
              "active",
              "completed"
            ],
            "title": "Status",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ended At"
          }
        },
        "required": [
          "session_id",
          "user_id",
          "exercise",
          "status",
          "started_at"
        ],
        "title": "WorkoutSession",
        "type": "object"
      },
      "RepEvent": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "exercise": {
            "$ref": "#/components/schemas/ExerciseType"
          },
          "sequence": {
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "started_at_ms": {
            "minimum": 0,
            "title": "Started At Ms",
            "type": "integer"
          },
          "ended_at_ms": {
            "minimum": 0,
            "title": "Ended At Ms",
            "type": "integer"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "form_score": {
            "maximum": 1,
            "minimum": 0,
            "title": "Form Score",
            "type": "number"
          },
          "feedback": {
            "items": {
              "$ref": "#/components/schemas/FormFeedback"
            },
            "maxItems": 20,
            "title": "Feedback",
            "type": "array"
          },
          "engine_version": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Engine Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "session_id",
          "exercise",
          "sequence",
          "started_at_ms",
          "ended_at_ms",
          "valid",
          "confidence",
          "form_score",
          "feedback",
          "engine_version"
        ],
        "title": "RepEvent",
        "type": "object"
      },
      "ChallengeParticipant": {
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Session Id"
          },
          "accepted_reps": {
            "minimum": 0,
            "title": "Accepted Reps",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "accepted_reps"
        ],
        "title": "ChallengeParticipant",
        "type": "object"
      },
      "Challenge": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "exercise": {
            "$ref": "#/components/schemas/ExerciseType"
          },
          "status": {
            "enum": [
              "waiting",
              "active",
              "completed"
            ],
            "title": "Status",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/ChallengeParticipant"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Participants",
            "type": "array"
          }
        },
        "required": [
          "challenge_id",
          "exercise",
          "status",
          "created_at",
          "participants"
        ],
        "title": "Challenge",
        "type": "object"
      },
      "ScoreUpdate": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "type": {
            "const": "challenge.score_updated",
            "title": "Type",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
